# --- DATABASE PATHÉ  ---
PORT_DB=15433
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=pathe_db

# --- SERVER PATHÉ ---
PORT_SERVER=4001
HOST_SERVER=0.0.0.0
# Le serveur Node se connecte au conteneur "database" sur son port interne 5432
DATABASE_URL=postgresql://root:root@database:5432/pathe_db
CORS_ORIGIN=*

# --- CLIENT PATHÉ ---
PORT_CLIENT=3001
# Le frontend doit pointer vers le nouveau port 4001 du serveur
VITE_API_BASE=http://localhost:4001